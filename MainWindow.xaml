<Window x:Class="WindowTilingManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Tiling Manager" Height="760" Width="1280"
        Icon="Assets/app.ico"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="레이아웃 지금 저장" Click="SaveLayout_Click"/>
                <MenuItem x:Name="RestoreOnStartupMenuItem" Header="시작할 때 실행 중인 이전 창 다시 붙이기" IsCheckable="True" IsChecked="True"
                          ToolTip="종료할 때 셀에 있던 창과 같은 프로그램의 창이 실행 중이면, 다음에 시작할 때 제자리에 다시 붙입니다. 프로그램을 새로 실행하지는 않습니다."/>
                <MenuItem Header="실행 중인 이전 창 다시 붙이기" Click="Reattach_Click"
                          ToolTip="비어 있는 복원 대기 셀에, 지금 실행 중인 같은 프로그램의 창을 붙입니다"/>
                <Separator/>
                <MenuItem Header="모든 창 분리" Click="ReleaseAll_Click"
                          ToolTip="현재 세트의 모든 창을 바탕화면으로 돌려보냅니다 (레이아웃 유지)"/>
                <MenuItem Header="셀 여러 개 선택해서 닫기..." Click="CloseCells_Click"
                          ToolTip="현재 세트의 셀(탭 포함)을 목록에서 여러 개 골라 한 번에 닫습니다"/>
                <MenuItem Header="현재 세트 초기화..." Click="ResetLayout_Click"
                          ToolTip="현재 세트의 모든 창을 바탕화면으로 돌려보내고 빈 셀 하나로 되돌립니다"/>
                <Separator/>
                <MenuItem Header="종료(_X)" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem x:Name="SetMenu" Header="세트(_S)" SubmenuOpened="SetMenu_SubmenuOpened">
                <MenuItem Header="(목록)"/>
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem x:Name="FullscreenMenuItem" Header="전체 화면" InputGestureText="F11" Click="Fullscreen_Click"/>
                <MenuItem x:Name="EdgeSwitchMenuItem" Header="전체 화면에서 화면 왼쪽/오른쪽 끝으로 세트 전환" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="TopmostMenuItem" Header="항상 위에 표시" IsCheckable="True"
                          Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
                <Separator/>
                <MenuItem x:Name="DragToCellMenuItem" Header="창을 끌어다 셀에 놓으면 배정" IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="사용법" Click="Help_Click"/>
            </MenuItem>
        </Menu>

        <!-- 세트 목록 (클릭: 전환, 더블클릭: 이름 바꾸기, 오른쪽 클릭: 세트 메뉴) -->
        <Border x:Name="SetBar" DockPanel.Dock="Top" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <WrapPanel x:Name="SetTabs"/>
        </Border>

        <StatusBar x:Name="StatusBarControl" DockPanel.Dock="Bottom" Background="#007ACC" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="준비"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 모든 세트가 겹쳐 놓이고 현재 세트만 보입니다 -->
        <Grid x:Name="WorkspaceHost"/>
    </DockPanel>
</Window>
