<Window x:Class="WindowTilingManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Tiling Manager" Height="760" Width="1280" MinWidth="480" MinHeight="320"
        Icon="Assets/app.ico"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- 메뉴 글자는 언어 파일(Languages/*.json)에서 읽어 코드(ApplyLanguage)에서 채웁니다. -->
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem x:Name="FileMenu">
                <MenuItem x:Name="SaveLayoutMenuItem" Click="SaveLayout_Click"/>
                <MenuItem x:Name="RestoreOnStartupMenuItem" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="ReattachMenuItem" Click="Reattach_Click"/>
                <Separator/>
                <MenuItem x:Name="ReleaseAllMenuItem" Click="ReleaseAll_Click"/>
                <MenuItem x:Name="CloseCellsMenuItem" Click="CloseCells_Click"/>
                <MenuItem x:Name="ResetSetMenuItem" Click="ResetLayout_Click"/>
                <Separator/>
                <MenuItem x:Name="ExitMenuItem" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem x:Name="SetMenu" SubmenuOpened="SetMenu_SubmenuOpened">
                <MenuItem Header="..."/>
            </MenuItem>
            <MenuItem x:Name="ViewMenu">
                <MenuItem x:Name="FullscreenMenuItem" InputGestureText="F11" Click="Fullscreen_Click"/>
                <MenuItem x:Name="EdgeSwitchMenuItem" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="TopmostMenuItem" IsCheckable="True"
                          Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
                <Separator/>
                <MenuItem x:Name="DragToCellMenuItem" IsCheckable="True" IsChecked="True"/>
                <Separator/>
                <MenuItem x:Name="LanguageMenu" SubmenuOpened="LanguageMenu_SubmenuOpened">
                    <MenuItem Header="..."/>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="HelpMenu">
                <MenuItem x:Name="HelpMenuItem" Click="Help_Click"/>
            </MenuItem>
        </Menu>

        <!-- 세트 목록 (클릭: 전환, 더블클릭: 이름 바꾸기, 오른쪽 클릭: 세트 메뉴) -->
        <Border x:Name="SetBar" DockPanel.Dock="Top" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <WrapPanel x:Name="SetTabs"/>
        </Border>

        <StatusBar x:Name="StatusBarControl" DockPanel.Dock="Bottom" Background="#007ACC" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 모든 세트가 겹쳐 놓이고 현재 세트만 보입니다 -->
        <Grid x:Name="WorkspaceHost"/>
    </DockPanel>
</Window>
